# Copia este archivo como secrets.toml y agrega tus keys reales.
# En Streamlit Community Cloud, configura esto en:
# App Settings > Secrets

ANTHROPIC_API_KEY = "sk-ant-...tu-key-aqui"

# (Opcional) Credenciales de Google Cloud Service Account para Google Sheets.
# Copia todo el contenido del archivo JSON de Service Account aquí.
# [gcp_service_account]
# type = "service_account"
# project_id = "tu-proyecto"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@...iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
